bench/results/*.log
# Written when a run leaves no result, for diagnosing it locally.
bench/results/*.error.txt

# A reproduction of the matrix (node bench/run.mjs --results bench/rerun) stays local.
bench/rerun/

# The demo renders are large and go stale whenever the skill's answer changes.
# demo/build.mjs rebuilds them in seconds, so it is the only tracked file here.
demo/*
!demo/build.mjs
# The ultracode and ultratoken probes (node bench/run.mjs --matrix bench/<name>-probe.json --results bench/probe) stay local.
bench/probe/
