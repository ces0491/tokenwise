{
  "defaults": {
    "maxBudgetUsd": 6,
    "timeoutMinutes": 25
  },
  "cases": {
    "implement": { "hidden": "implement", "restoreTests": true, "grader": "tests" },
    "debug": { "hidden": "debug", "restoreTests": true, "grader": "tests" },
    "review": { "overlayUncommitted": true, "grader": "review" },
    "explore": { "grader": "explore" },
    "chore": { "grader": "chore" },
    "multi": { "overlays": ["debug"], "branch": { "name": "review-me", "overlay": "review" }, "testsJob": { "section": "fix", "hidden": "debug" }, "grader": "multi" },
    "multi-large": { "overlays": ["implement"], "branch": { "name": "review-me", "overlay": "review" }, "testsJob": { "section": "implement", "hidden": "implement" }, "grader": "multi" }
  },
  "runs": [
    { "id": "chore-haiku", "repeat": 3, "case": "chore", "model": "haiku" },
    { "id": "chore-sonnet-low", "repeat": 3, "case": "chore", "model": "sonnet", "effort": "low" },
    { "id": "chore-opus-xhigh", "repeat": 3, "case": "chore", "model": "opus", "effort": "xhigh" },

    { "id": "explore-opus-inherit", "repeat": 3, "case": "explore", "model": "opus", "effort": "xhigh" },
    { "id": "explore-opus-haiku-sub", "repeat": 3, "case": "explore", "model": "opus", "effort": "xhigh",
      "env": { "CLAUDE_CODE_SUBAGENT_MODEL": "haiku", "CLAUDE_CODE_SUBAGENT_MODEL_FORCE": "1" } },

    { "id": "debug-haiku", "case": "debug", "model": "haiku" },
    { "id": "debug-sonnet-medium", "repeat": 3, "case": "debug", "model": "sonnet", "effort": "medium" },
    { "id": "debug-sonnet-xhigh", "case": "debug", "model": "sonnet", "effort": "xhigh" },
    { "id": "debug-opus-high", "repeat": 3, "case": "debug", "model": "opus", "effort": "high" },
    { "id": "debug-opus-xhigh", "repeat": 3, "case": "debug", "model": "opus", "effort": "xhigh" },
    { "id": "debug-opus-ultracode", "repeat": 3, "case": "debug", "model": "opus", "effort": "ultracode", "maxBudgetUsd": 20, "timeoutMinutes": 45 },

    { "id": "review-sonnet-high", "repeat": 3, "case": "review", "model": "sonnet", "effort": "high" },
    { "id": "review-opus-low", "repeat": 3, "case": "review", "model": "opus", "effort": "low" },
    { "id": "review-opus-high", "repeat": 3, "case": "review", "model": "opus", "effort": "high" },
    { "id": "review-opus-xhigh", "repeat": 3, "case": "review", "model": "opus", "effort": "xhigh" },
    { "id": "review-opus-ultracode", "repeat": 3, "case": "review", "model": "opus", "effort": "ultracode", "maxBudgetUsd": 20, "timeoutMinutes": 45 },
    { "id": "review-fable-high", "case": "review", "model": "fable", "effort": "high" },

    { "id": "implement-haiku", "case": "implement", "model": "haiku" },
    { "id": "implement-sonnet-low", "case": "implement", "model": "sonnet", "effort": "low" },
    { "id": "implement-sonnet-medium", "repeat": 3, "case": "implement", "model": "sonnet", "effort": "medium" },
    { "id": "implement-sonnet-high", "case": "implement", "model": "sonnet", "effort": "high" },
    { "id": "implement-sonnet-xhigh", "repeat": 3, "case": "implement", "model": "sonnet", "effort": "xhigh" },
    { "id": "implement-opus-medium", "repeat": 3, "case": "implement", "model": "opus", "effort": "medium" },
    { "id": "implement-opus-xhigh", "repeat": 3, "case": "implement", "model": "opus", "effort": "xhigh" },
    { "id": "implement-fable-xhigh", "case": "implement", "model": "fable", "effort": "xhigh" },

    { "id": "split-plan-opus-xhigh", "case": "implement", "model": "opus", "effort": "xhigh", "prompt": "prompt-plan.md", "grader": "plan" },
    { "id": "split-impl-sonnet-medium", "case": "implement", "model": "sonnet", "effort": "medium", "prompt": "prompt-implement-plan.md", "dirFrom": "split-plan-opus-xhigh" },

    { "id": "multi-opus-xhigh", "repeat": 3, "case": "multi", "model": "opus", "effort": "xhigh", "plugin": true, "maxBudgetUsd": 12, "timeoutMinutes": 40 },
    { "id": "multi-opus-xhigh-ultratoken", "repeat": 3, "case": "multi", "model": "opus", "effort": "xhigh", "plugin": true, "keyword": "ultratoken", "maxBudgetUsd": 12, "timeoutMinutes": 40 },
    { "id": "multi-sonnet-medium", "repeat": 3, "case": "multi", "model": "sonnet", "effort": "medium", "plugin": true, "maxBudgetUsd": 12, "timeoutMinutes": 40 },
    { "id": "multi-sonnet-medium-ultratoken", "repeat": 3, "case": "multi", "model": "sonnet", "effort": "medium", "plugin": true, "keyword": "ultratoken", "maxBudgetUsd": 12, "timeoutMinutes": 40 },
    { "id": "multi-large-opus-xhigh", "repeat": 3, "case": "multi-large", "model": "opus", "effort": "xhigh", "plugin": true, "maxBudgetUsd": 20, "timeoutMinutes": 60 },
    { "id": "multi-large-opus-xhigh-ultratoken", "repeat": 3, "case": "multi-large", "model": "opus", "effort": "xhigh", "plugin": true, "keyword": "ultratoken", "maxBudgetUsd": 20, "timeoutMinutes": 60 },
    { "id": "multi-large-sonnet-medium", "repeat": 3, "case": "multi-large", "model": "sonnet", "effort": "medium", "plugin": true, "maxBudgetUsd": 20, "timeoutMinutes": 60 },
    { "id": "multi-large-sonnet-medium-ultratoken", "repeat": 3, "case": "multi-large", "model": "sonnet", "effort": "medium", "plugin": true, "keyword": "ultratoken", "maxBudgetUsd": 20, "timeoutMinutes": 60 },

    { "id": "cache-resume-same-model", "resumeFrom": "implement-opus-xhigh", "model": "opus", "effort": "xhigh", "promptText": "In one line, what did you change?", "grader": "none" },
    { "id": "cache-resume-switch-model", "resumeFrom": "implement-opus-xhigh", "model": "sonnet", "effort": "xhigh", "promptText": "In one line, what did you change?", "grader": "none", "after": "cache-resume-same-model" },

    { "id": "cache-resume-same-model-2", "resumeFrom": "implement-opus-xhigh", "model": "opus", "effort": "xhigh", "promptText": "In one line, which file holds the credit note logic?", "grader": "none", "after": "cache-resume-switch-model" },
    { "id": "cache-resume-same-model-3", "resumeFrom": "implement-opus-xhigh", "model": "opus", "effort": "xhigh", "promptText": "In one line, which test file did you add?", "grader": "none", "after": "cache-resume-same-model-2" },
    { "id": "cache-resume-switch-model-2", "resumeFrom": "implement-opus-xhigh", "model": "sonnet", "effort": "xhigh", "promptText": "In one line, which function computes credit totals?", "grader": "none", "after": "cache-resume-same-model-3" }
  ]
}
